# margAI Environment Configuration
# Copy this to .env and fill in your values.
#
# Everything deployment-specific lives here, not in margAI.toml, so the same
# TOML works for every host. margAI reads MARGAI_PROVIDER_BASE_URL_<NAME> to
# override a provider's upstream defined in the TOML.

# Ollama upstream.
#
# This WSL2 is in MIRRORED networking mode, so WSL and Windows share one
# loopback. margAI runs with network_mode: host, so it shares that namespace
# and can reach Windows-native Ollama on the Windows loopback directly:
#   http://127.0.0.1:11434/v1
#
# If you ever run margAI on a BRIDGE network instead, that address stops
# working (the container gets its own empty loopback). Use the shared-ollama
# relay from ~/docker/shared/docker-compose.yml:
#   MARGAI_OLLAMA_URL=http://host.docker.internal:11435/v1
# ...plus extra_hosts "host.docker.internal:host-gateway".
MARGAI_OLLAMA_URL=http://127.0.0.1:11434/v1

# Optional: API keys for external providers
# Only needed if you're routing to these providers through margAI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
